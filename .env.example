# ============================================================
# H-Sport Financial dApp — Environment Template
# Salin file ini menjadi `.env` lalu isi nilai lokal.
# JANGAN commit `.env` atau private key apa pun.
# ============================================================

# --- Database (MySQL Laragon) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=h_sport_db
DB_USER=root
DB_PASS=

# --- Blockchain (Ganache lokal) ---
RPC_URL=http://127.0.0.1:7545
CHAIN_ID=1337
NETWORK_ID=5777
CONTRACT_ADDRESS=
CONTRACT_ABI_PATH=blockchain/config/contract_abi.json

# --- Operator (HANYA untuk Ganache lokal) ---
# Isi dengan akun Ganache yang sudah ditambahkan sebagai operator.
# Private key tidak boleh masuk repo, screenshot, atau dokumen.
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=

# --- Worker paralel ---
WORKER_COUNT=4
JOB_TIMEOUT_SECONDS=300
BENCHMARK_SEED=HSPORT-2026
